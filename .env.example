# ==============================================================================
# Servidor & Entorno (CogniJuegos - Puerto 8087)
# ==============================================================================
PORT=8087
HOST=0.0.0.0
SERVICE_KEY=conmijuegos

# ==============================================================================
# Base de datos MongoDB Centralizada (Vía red externa red-mongo-compartida)
# ==============================================================================
# En producción con contenedor compartido mongodb-central:
MONGO_URI=mongodb://admin_central:TU_PASSWORD_MONGO@mongodb-central:27017/conmijuegos_db?authSource=admin
# Fallback para desarrollo local sin Docker:
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=conmijuegos_db

# ==============================================================================
# JWT & Seguridad (Debe coincidir exactamente con JWT_SECRET del Autenticador)
# ==============================================================================
JWT_SECRET=super_secret_autenticador_key_2026
JWT_SECRET_FALLBACK=K8v_3mNp92WzX5qL7rT4yB1cV6jH0gF2sA9dE4uI
JWT_EXPIRATION_DAYS=180
FRONTEND_URL=https://cognijuegos.asistodo.com.ar

# ==============================================================================
# Microservicio Autenticador Central (Single Source of Truth)
# ==============================================================================
AUTH_SERVICE_URL=https://autenticacion.asistodo.com.ar

# ==============================================================================
# APIs Externas
# ==============================================================================
RAE_API_KEY=tu_api_key_de_la_rae_aqui

# ==============================================================================
# Correo SMTP (Opcional)
# ==============================================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASSWORD=tu_clave_smtp_aqui
MAIL_FROM=tu_correo_emisor@dominio.com
MAIL_FROM_NAME=CogniJuegos

