# ==============================================================================
# Servidor & Entorno (CogniJuegos - Puerto 8087)
# ==============================================================================
PORT=8087
HOST=0.0.0.0
SERVICE_KEY=cognijuegos

# ==============================================================================
# Base de datos MongoDB Centralizada (Vía red externa red-mongo-compartida)
# ==============================================================================
# Opción 1: Variables desglosadas (Recomendado para contenedor mongodb-central)
MONGO_HOST=mongodb-central
MONGO_PORT=27017
MONGO_ROOT_USER=admin_central
MONGO_ROOT_PASSWORD=tu_password_mongo_aqui
MONGO_AUTH_SOURCE=admin
MONGO_DB_NAME=conmijuegos_db

# Opción 2: URI directa (Opcional/Fallback)
# MONGO_URI=mongodb://admin_central:tu_password_mongo_aqui@mongodb-central:27017/conmijuegos_db?authSource=admin

# Fallback para desarrollo local fuera de Docker:
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=conmijuegos_db

# ==============================================================================
# JWT & Seguridad (Debe coincidir exactamente con JWT_SECRET del Autenticador)
# ==============================================================================
JWT_SECRET=tu_secreto_jwt_del_autenticador
JWT_SECRET_FALLBACK=tu_secreto_jwt_fallback_opcional
JWT_EXPIRATION_DAYS=180
FRONTEND_URL=https://cognijuegos.asistodo.com.ar

# ==============================================================================
# Microservicio Autenticador Central (Single Source of Truth)
# ==============================================================================
AUTH_SERVICE_URL=https://autenticacion.asistodo.com.ar

# ==============================================================================
# APIs Externas
# ==============================================================================
RAE_API_KEY=tu_api_key_de_la_rae_aqui

# ==============================================================================
# Correo SMTP (Opcional)
# ==============================================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASSWORD=tu_clave_smtp_aqui
MAIL_FROM=tu_correo_emisor@dominio.com
MAIL_FROM_NAME=CogniJuegos
