# ==============================================================================
# Caddyfile — CogniJuegos (https://cognijuegos.asistodo.com.ar — Puerto :8087)
# Sirve la SPA compilada desde /srv/dist y redirige las llamadas API al backend
# ==============================================================================

:8087 {
    # 1. Compresión para máxima velocidad de respuesta
    encode zstd gzip

    # 2. Encabezados globales de seguridad (Hardening Perimetral)
    header {
        # Ocultar la firma del servidor web y frameworks
        -Server
        -X-Powered-By

        # Prevención de ataques MIME-sniffing
        X-Content-Type-Options "nosniff"

        # Protección anti-clickjacking
        X-Frame-Options "DENY"

        # Política de privacidad en referencias
        Referrer-Policy "strict-origin-when-cross-origin"

        # Restringir permisos de APIs del navegador que la app no necesita
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # 3. Protección contra Payloads excesivos (Anti-DoS)
    request_body {
        max_size 10MB
    }

    # 4. Bloquear acceso a archivos ocultos (.env, .git, etc.) y sondas maliciosas
    @hidden path */.*
    respond @hidden 404

    @probes path *..* *.env* *.git* *.bak* *.sql* *.conf* *.ini* /admin/config* /etc/* /proc/* /windows/*
    respond @probes 404

    # 5. Reverse Proxy de /api/* y endpoints del Backend hacia FastAPI (backend:8087)
    @backend path /api/* /usuario* /progreso* /admin* /assets/narrative* /health* /actuator*
    handle @backend {
        reverse_proxy backend:8087
    }

    # 6. Servir archivos estáticos compilados del Frontend (SPA) desde /srv/dist
    handle {
        root * /srv/dist
        try_files {path} /index.html
        file_server
    }
}
